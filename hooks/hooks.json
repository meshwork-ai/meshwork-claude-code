{
  "description": "Meshwork 자산 보호(로그인 토큰 · 설정 폴더 · 플러그인 설치본 · 훅을 끄는 설정만 막음) · 채널 도착 확인(첫 팀 메시지가 AI 에게 들어갔는지 — 출력 없음)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/channel.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/channel.sh\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
